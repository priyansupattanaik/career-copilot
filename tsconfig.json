{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./frontend",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "env.d.ts",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "frontend/*.ts",
    "frontend/*.tsx"
  ],
  "exclude": ["frontend/node_modules", "frontend/dist"]
}
