# Career Copilot Backend Environment Variables (Render / Local)
# These variables are private to the backend service. Never expose to client.

# Core Application Settings
APP_NAME=Career Copilot API
APP_ENV=development
API_V1_PREFIX=/api/v1
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=info
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://careercopilotai.vercel.app

# Supabase Server-Side Settings (Database, Auth & Object Storage)
SUPABASE_URL=https://your-project.supabase.co
# Secret / service-role key for backend PostgREST and Auth admin operations:
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=career-copilot-files
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Storage folder prefixes
DOCUMENT_BUCKET=resumes
AVATAR_BUCKET=avatars

# Authentication JWT Settings
AUTH_SECRET=your-random-jwt-secret-at-least-32-chars
JWT_TTL_SECONDS=604800

# LLM Providers (Server-Only)
# NVIDIA NIM API (optional, for Nemotron analysis)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_PROMPT_VERSION=v1
NVIDIA_TIMEOUT_SECONDS=90

# Groq API (optional, for resume parsing and Orpheus TTS)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RESUME_PARSER_ENABLED=true
GROQ_RESUME_PARSER_MODEL=llama-3.3-70b-versatile
GROQ_RESUME_PARSER_FALLBACK_MODEL=openai/gpt-oss-120b

# Job Search & Learning Integrations (optional)
FREEHIRE_ENABLED=true
FREEHIRE_API_URL=https://freehire.me
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
