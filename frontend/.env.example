# Career Copilot Frontend Environment Variables (Vercel / Local)
# Only VITE_ prefixed variables are bundled into client code.
# NEVER put private keys, database passwords, or service-role keys here.

# Supabase Web App Configuration [Required in production]
# From Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Public App Origin (Vercel deployment URL)
VITE_PUBLIC_APP_ORIGIN=https://careercopilotai.vercel.app

# Optional Upstream Backend URL (leave blank for local Vite dev proxy to /api/backend)
# In production on Vercel without reverse proxy, set to Render backend URL:
# VITE_API_BASE_URL=https://career-copilot-api.onrender.com

# API Version prefix (default: /api/v1)
VITE_API_V1_PREFIX=/api/v1
